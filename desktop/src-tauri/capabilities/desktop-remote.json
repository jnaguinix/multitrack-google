{
  "identifier": "desktop-remote",
  "description": "Control local del servidor LAN y motor de audio",
  "windows": ["main"],
  "permissions": [
    "allow-remote-status",
    "allow-remote-start",
    "allow-remote-stop",
    "allow-remote-kick",
    "allow-remote-exchange",
    "allow-desktop-update-check",
    "allow-desktop-update-download",
    "allow-desktop-update-install",
    "dialog:allow-open",
    "allow-audio-list-hosts",
    "allow-audio-list-devices",
    "allow-audio-get-config",
    "allow-audio-set-config",
    "allow-audio-get-stats",
    "allow-audio-test-tone"
  ]
}

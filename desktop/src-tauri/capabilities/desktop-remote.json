{
  "identifier": "desktop-remote",
  "description": "Control local del servidor LAN y motor de audio",
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-remote-status",
    "allow-remote-start",
    "allow-remote-stop",
    "allow-remote-kick",
    "allow-remote-exchange",
    "allow-desktop-update-check",
    "allow-desktop-update-download",
    "allow-desktop-update-install",
    "dialog:allow-open",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-audio-list-hosts",
    "allow-audio-list-devices",
    "allow-audio-get-config",
    "allow-audio-set-config",
    "allow-audio-get-stats",
    "allow-audio-reset-stats",
    "allow-audio-test-tone",
    "allow-audio-import-tracks",
    "allow-audio-import-track-bytes",
    "allow-audio-import-folder",
    "allow-audio-cancel-import",
    "allow-audio-get-project-cache-status",
    "allow-audio-load-project",
    "allow-audio-play",
    "allow-audio-pause",
    "allow-audio-stop",
    "allow-audio-seek",
    "allow-audio-get-playback-state",
    "allow-audio-set-track-controls",
    "allow-audio-queue-jump",
    "allow-audio-cancel-jump",
    "allow-audio-toggle-vamp",
    "allow-audio-set-pitch",
    "allow-audio-set-metronome",
    "allow-audio-set-split-mono",
    "allow-audio-configure-song",
    "allow-audio-preload-project",
    "allow-audio-set-master-gains",
    "allow-audio-switch-to-preloaded",
    "allow-audio-reopen-stream",
    "allow-audio-scan-folder",
    "allow-audio-scan-files",
    "allow-audio-import-track-bytes-raw",
    "allow-audio-delete-project-cache",
    "allow-audio-get-cache-stats",
    "allow-audio-clean-orphan-caches",
    "allow-audio-check-files-exist",
    "allow-library-load",
    "allow-library-save",
    "allow-library-save-song",
    "allow-library-delete-song",
    "allow-library-update-song-folder",
    "allow-library-write-sidecar",
    "allow-library-read-sidecar"
  ]
}
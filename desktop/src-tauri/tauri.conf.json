{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OmniTracks",
  "version": "0.2.2",
  "identifier": "org.libretracks.desktop.poc",
  "build": {
    "beforeBuildCommand": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./build-frontend.ps1",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "OmniTracks",
        "width": 1280,
        "height": 800,
        "useHttpsScheme": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "capabilities": ["desktop-remote"],
      "csp": {
        "default-src": "'self'",
        "connect-src": "'self' ipc: https://ipc.localhost",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self'",
        "img-src": "'self' data: blob:",
        "worker-src": "'self' blob:",
        "frame-src": "'none'",
        "object-src": "'none'",
        "base-uri": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "OmniTracks",
    "icon": ["icons/icon.ico"],
    "windows": {
      "nsis": { "installMode": "currentUser" },
      "webviewInstallMode": { "type": "offlineInstaller" }
    }
  }
}
